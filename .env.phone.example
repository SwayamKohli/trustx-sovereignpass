# Requires Node 24+, mkcert trust setup, same-network DNS and iPhone CA trust.
# Replace the hostname below with your Mac's lower-case LocalHostName + .local.
# Never use a bare IP as the WebAuthn RP ID.
LOCAL_HTTP=0
PORT=3000
PHISH_PORT=3001
VITE_PORT=5173
RP_ID=your-mac.local
EXPECTED_ORIGIN=https://your-mac.local:3000
FAKE_PHISHING_ORIGIN=https://127.0.0.1:3001
TRUSTX_CERT_FILE=certs/phone-cert.pem
TRUSTX_KEY_FILE=certs/phone-key.pem
