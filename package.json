{
  "name": "trustx-sovereignpass",
  "version": "1.0.0",
  "private": true,
  "description": "TrustX SovereignPass: Phishing-Resistant Passwordless Authentication with Shared-Device Session Security & Constrained AI-Agent Delegation",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/start-dev.cjs",
    "dev:phone": "node --use-system-ca scripts/start-dev.cjs --phone",
    "dev:stack": "concurrently -k -n \"BANK,FRONTEND,ATTACKER\" -c \"cyan,magenta,red\" \"npm run dev --workspace=@trustx/backend\" \"npm run dev --workspace=@trustx/frontend\" \"npm run dev:phishing --workspace=@trustx/backend\"",
    "admin:grant": "npm run admin:grant --workspace=@trustx/backend --",
    "dev:backend": "npm run dev --workspace=@trustx/backend",
    "dev:frontend": "npm run dev --workspace=@trustx/frontend",
    "dev:frontend:mock": "npm run dev:mock --workspace=@trustx/frontend",
    "build": "npm run build --workspaces",
    "test": "node --test scripts/start-dev.test.cjs && npm run test --workspaces",
    "test:attacks": "npm run test:attacks --workspace=@trustx/backend",
    "dev:phishing": "npm run dev:phishing --workspace=@trustx/backend",
    "audit:export": "npm run audit:export --workspace=@trustx/backend",
    "benchmark:pqc": "node --no-warnings -r ts-node/register scripts/benchmarks/pqc_benchmark.ts"
  },
  "devDependencies": {
    "@noble/post-quantum": "^0.7.1",
    "@types/node": "^22.13.1",
    "concurrently": "^9.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
