{
  "name": "@trustx/backend",
  "version": "1.0.0",
  "private": true,
  "description": "TrustX SovereignPass Core Backend & API Gateway",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "admin:grant": "tsx src/scripts/grant-admin.ts",
    "dev:phishing": "tsx src/phishing-server.ts",
    "build": "tsc",
    "test": "ts-node test/services.test.ts && tsx test/live-demo.test.ts",
    "test:attacks": "tsx test/test_attacks.ts",
    "test:challenges": "tsx src/scripts/test-challenges.ts",
    "test:lifecycle": "tsx test/test_identity_lifecycle.ts",
    "audit:export": "tsx src/scripts/export-audit-log.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.1.1",
    "argon2": "^0.41.1",
    "better-sqlite3": "12.11.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
