# Loopback rehearsal. Copy to .env; do not commit credentials or private certificate keys.
LOCAL_HTTP=1
PORT=3000
PHISH_PORT=3001
VITE_PORT=5173

# For real-phone HTTPS: set LOCAL_HTTP=0, install trusted certificates for both
# reachable domain names, and configure DNS on laptop AND phone. Register fresh
# passkeys at the HTTPS bank origin; localhost passkeys do not transfer domains.
# RP_ID=bank.example.test
# EXPECTED_ORIGIN=https://bank.example.test:3000
# FAKE_PHISHING_ORIGIN=https://attacker.example.test:3001
# ORIGIN is a legacy alias. Do not set it to a different value.
